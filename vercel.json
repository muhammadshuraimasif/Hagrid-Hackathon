{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "index.py", "use": "@vercel/python", "config": { "maxLambdaSize": "500mb", "excludeFiles": "{web/**,docs/**,uploads/**,dist/**,**/__pycache__/**,**/*.db,api/tests/**}" } },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/(api/.*|docs|docs/.*|redoc|openapi\\.json|health|ready)", "dest": "/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html", "headers": { "X-Prototype": "Project Amaanat - Hagrid's Hackathon Prototype" } }
  ]
}
