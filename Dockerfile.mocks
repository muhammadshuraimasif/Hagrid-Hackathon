FROM python:3.12-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install minimal dependencies for mock services
COPY mocks/requirements.txt ./mocks_requirements.txt
RUN pip install --no-cache-dir -r mocks_requirements.txt

# Copy repository source code (since Python imports depend on repo root)
COPY . .

# Railway dynamically injects PORT; default to 8001 locally
ENV PORT=8001

EXPOSE 8001

# Start mock public rails services binding 0.0.0.0 on $PORT
CMD ["sh", "-c", "uvicorn mocks.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
