# Project Amaanat - Environment Variables Configuration Template
# COPY TO .env AND FILL IN YOUR CREDENTIALS (NEVER COMMIT .env)
# PROTOTYPE ONLY - Hackathon Prototype, Not an Official Government Service

# 1. Environment & Prototype Safety
ENVIRONMENT=development
IS_PROTOTYPE=true
TESTING=0

# 2. Database Connection
# SQLite for local offline demonstration / tests: sqlite+aiosqlite:///./demo.db
# PostgreSQL for production cloud deployment: postgresql+asyncpg://user:pass@host:5432/amaanat_db
DATABASE_URL=sqlite+aiosqlite:///./demo.db

# 3. Cryptographic Secrets & JWT
JWT_SECRET=amaanat-super-secure-jwt-secret-key-for-development-mode-2026
DECISION_TOKEN_SECRET=amaanat-capability-decision-token-secret-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. Disbursement Safety Hold
# 60 seconds reversible hold for instant demo reversibility
HOLD_DURATION_SECONDS=60

# 5. External AI & Vision Services
# Optional: Google Gemini API key for OCR/Vision field extraction & ScamShield LLM
GEMINI_API_KEY=
# Optional: System path to Tesseract OCR binary (gracefully skipped if omitted)
TESSERACT_CMD=tesseract

# 6. Mock Public Rails Services
MOCK_SERVICES_URL=http://127.0.0.1:8001

# 7. Password Hashing (Argon2id)
# Fast hashing in test mode is enabled automatically when TESTING=1
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
