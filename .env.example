# Project Amaanat - Environment Variables Configuration Template
# COPY TO .env AND FILL IN YOUR CREDENTIALS (NEVER COMMIT .env)

# Environment & Prototype Warnings
ENVIRONMENT=development
IS_PROTOTYPE=true

# Database URL (SQLite for local testing/dev, Postgres for production)
DATABASE_URL=sqlite+aiosqlite:///./test_amaanat.db

# Security & Secrets
JWT_SECRET=amaanat-super-secure-jwt-secret-key-for-development-mode-2026
DECISION_TOKEN_SECRET=amaanat-capability-decision-token-secret-2026

# External AI & Public Rails
GEMINI_API_KEY=your_gemini_api_key_here
MOCK_SERVICES_URL=http://127.0.0.1:8001
TESSERACT_CMD=tesseract
